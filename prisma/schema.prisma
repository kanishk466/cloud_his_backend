generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}



enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT
}

enum HospitalStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum PackageAssignmentStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum HospitalUserStatus {
  ACTIVE
  INACTIVE
}

enum HospitalUserType {
  SUPER_ADMIN
  REGULAR_USER
  DOCTOR
}

enum LoginType {
  PASSWORD
  OTP
  BOTH
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ============================================
// ENUMS — OPD STEP 1 (Patient)
// ============================================

enum PatientType {
  NEW
  REVIEW
  REFERRAL
  EMERGENCY
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  DECEASED
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  UNKNOWN
}

enum RelationType {
  SELF
  SPOUSE
  FATHER
  MOTHER
  SON
  DAUGHTER
  BROTHER
  SISTER
  GUARDIAN
  OTHER
}

// ============================================
// ENUMS — OPD STEP 2 (Appointment)
// ============================================

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  IN_QUEUE
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  WALK_IN
  SCHEDULED
  EMERGENCY
  TELECONSULTATION
}

enum VisitType {
  NEW_VISIT
  FOLLOW_UP
  REVIEW
  REFERRAL
  POST_OP
  EMERGENCY
}

// ============================================
// ENUMS — OPD STEP 3 (Queue / Token)
// ============================================

enum TokenStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  SKIPPED
  CANCELLED
}

// ============================================
// ENUMS — OPD (Placeholder for upcoming steps)
// ============================================

enum ConsultationStatus {
  IN_PROGRESS
  COMPLETED
  REFERRED
}

enum PrescriptionFrequency {
  ONCE_DAILY
  TWICE_DAILY
  THRICE_DAILY
  FOUR_TIMES_DAILY
  EVERY_6_HOURS
  EVERY_8_HOURS
  EVERY_12_HOURS
  AS_NEEDED
  BEFORE_MEALS
  AFTER_MEALS
  AT_BEDTIME
  STAT
  WEEKLY
  CUSTOM
}

enum MealRelation {
  BEFORE_FOOD
  AFTER_FOOD
  WITH_FOOD
  EMPTY_STOMACH
  NOT_APPLICABLE
}

enum MedicineRoute {
  ORAL
  IV
  IM
  SC
  TOPICAL
  SUBLINGUAL
  INHALATION
  RECTAL
  NASAL
  OPHTHALMIC
  OTIC
  OTHER
}

enum InvestigationType {
  LAB
  RADIOLOGY
  PATHOLOGY
  CARDIOLOGY
  OTHER
}

enum InvestigationUrgency {
  ROUTINE
  URGENT
  STAT
}

enum InvestigationStatus {
  ORDERED
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  WAIVED
}

enum PaymentMode {
  CASH
  CARD
  UPI
  INSURANCE
  ONLINE
  MIXED
}

enum BillStatus {
  DRAFT
  GENERATED
  PAID
  PARTIALLY_PAID
  CANCELLED
  REFUNDED
}

// ============================================
// PLATFORM SIDE
// ============================================

model PlatformUser {
  id                  String        @id @default(uuid())
  email               String        @unique
  passwordHash        String
  firstName           String
  lastName            String?
  status              UserStatus    @default(ACTIVE)
  role                PlatformRole  @default(PLATFORM_ADMIN)
  // === SECURITY ADDITION START ===
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?     @map("locked_until")
  passwordChangedAt   DateTime      @default(now()) @map("password_changed_at")
  twoFactorEnabled    Boolean       @default(false) @map("two_factor_enabled")
  sessions            AuthSession[] @relation("PlatformSessions")
  loginOtps           LoginOtp[]    @relation("PlatformOtps")
  // === SECURITY ADDITION END ===

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_users")
}

model RefreshToken {
  id        String       @id @default(uuid())
  token     String
  expiresAt DateTime
  userId    String
  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@map("refresh_tokens")
}

// ============================================
// SAAS CORE (Modules, Features, Packages)
// ============================================

model Module {
  id        Int      @id @default(autoincrement())
  name      String
  code      String   @unique
  route     String?
  icon      String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  parentId  Int?
  parent    Module?  @relation("ModuleHierarchy", fields: [parentId], references: [id])
  children  Module[] @relation("ModuleHierarchy")

  features       ModuleFeature[]
  packageModules PackageModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("modules")
}

model Feature {
  id          Int     @id @default(autoincrement())
  name        String
  code        String  @unique
  description String?

  modules ModuleFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("features")
}

model ModuleFeature {
  moduleId  Int
  featureId Int
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  rolePermissions HospitalRolePermission[]
  userPermissions UserModuleFeaturePermission[]

  @@id([moduleId, featureId])
  @@map("module_features")
}

model Package {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  monthlyPrice Int
  yearlyPrice  Int
  maxDoctors   Int
  maxStorageGb Int
  maxBranches  Int
  isPopular    Boolean @default(false)

  modules          PackageModule[]
  assignedPackages AssignedPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("packages")
}

model PackageModule {
  packageId Int
  moduleId  Int
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([packageId, moduleId])
  @@map("package_modules")
}

// ============================================
// TENANT / HOSPITAL
// ============================================

model Hospital {
  id       Int    @id @default(autoincrement()) // ✅ Changed from String uuid
  tenantId String @unique @default(uuid())

  code        String         @unique
  name        String
  email       String         @unique
  phone       String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  timezone    String         @default("Asia/Kolkata")
  logoUrl     String?
  status      HospitalStatus @default(DRAFT)
  activatedAt DateTime?

  // Phase 1 Relations
  packages             AssignedPackage[]
  users                HospitalUser[]
  hospitalRoles        HospitalRole[]
  departments          Department[]
  shifts               ShiftMaster[]
  roleNamesCreated     RoleName[]
  doctorProfiles       DoctorProfile[]
  doctorAvailabilities DoctorAvailability[]
  doctorLeaveBlocks    DoctorLeaveBlock[]

  // OPD Step 1

  tenantSequences TenantSequence[]
  patients        Patient[]

  // OPD Step 2
  appointments Appointment[]

  // OPD Step 3
  opdTokens OpdToken[]

  // OPD Step 6
  opdBills     OpdBill[]
  opdBillItems OpdBillItem[]
  opdPayments  OpdPayment[]

  patientVitals       PatientVitals[]
  consultations       Consultation[]
  prescriptions       Prescription[]
  investigationOrders InvestigationOrder[]
  globalMasters       GlobalMaster[]
  panels              Panel[]

  serviceMasters    ServiceMaster[]
  tariffMasters     TariffMaster[]
  panelServiceRates PanelServiceRate[]

  // Phase 1.1 — Basic Masters
  banks                Bank[]
  patientDocumentTypes PatientDocumentType[]

  // Phase 1.2 — Discount Masters
  discountReasons             DiscountReason[]
  discountApprovalAuthorities DiscountApprovalAuthority[]

  // Phase 2.1 — Services Setup
  serviceCategoryMasters ServiceCategoryMaster[]
  serviceSubCategories   ServiceSubCategory[]

  // Phase 2.2 — Doctor Setup
  clinicalDepartments   ClinicalDepartment[]
  specializations       Specialization[]
  doctorOpdVisitConfigs DoctorOpdVisitConfig[]
  referDoctors          ReferDoctor[]

  // Phase 2.2B — Doctor Integration
  referralCommissions ReferralCommission[]

  // Phase 2.3 — Ward, Room & Bed (IPD Foundation)
  roomTypes    RoomType[]
  rooms        Room[]
  beds         Bed[]
  bedStatuses  BedStatus[]
  bedAmenities BedAmenity[]

  // Phase 1.4 + IPD
  thresholdLimits ThresholdLimit[]
  ipdAdmissions   IpdAdmission[]

  // Phase 2.4 — Lab/Radio (LIS/RIS)
  labDepartments  LabDepartment[]
  investigations  Investigation[]
  observations    Observation[]
  referenceRanges ReferenceRange[]

  // Phase 2.4 Session 2 — Templates, Interpretations, Help & Comments
  reportTemplates              ReportTemplate[]
  investigationInterpretations InvestigationInterpretation[]
  observationHelps             ObservationHelp[]
  reportComments               ReportComment[]

  // Phase 2.4 Session 3 — Pre-analytical
  sampleContainerMasters SampleContainerMaster[]
  sampleTypes            SampleType[]

  // Phase 2.4 Session 4 — Microbiology, Outsource & Sign-off
  organismMasters       OrganismMaster[]
  antibioticMasters     AntibioticMaster[]
  outsourceLabMasters   OutsourceLabMaster[]
  labSignoffAuthorities LabSignoffAuthority[]

  // Phase 3.1 — Panel Enhancements
  rateSchedules  RateSchedule[]
  panelDocuments PanelDocument[]

  // Phase 3.2 — Packages
  packageMasters        PackageMaster[]
  packageComponents     PackageComponent[]
  packageDoctorConsults PackageDoctorConsult[]
  packageExclusions     PackageExclusion[]
  packageConsumptions   PackageConsumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hospitals")
}

// ============================================
// PHASE 1.1 — GEO MASTERS (System-level lookups)
// ============================================

model Country {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  isoCode   String  @unique
  phoneCode String?
  isActive  Boolean @default(true)

  states State[]

  @@map("countries")
}

model State {
  id        Int     @id @default(autoincrement())
  name      String
  stateCode String?
  countryId Int
  isActive  Boolean @default(true)

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities  City[]

  @@unique([countryId, name])
  @@map("states")
}

model City {
  id       Int     @id @default(autoincrement())
  name     String
  stateId  Int
  isActive Boolean @default(true)

  state State @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([stateId, name])
  @@map("cities")
}

// ============================================
// PHASE 1.1 — TENANT-SCOPED MASTERS
// ============================================

model Bank {
  id            String    @id @default(uuid())
  tenantId      String
  bankName      String
  branchName    String?
  ifscCode      String?
  accountNumber String?
  accountType   String?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?

  hospital Hospital @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, bankName, accountNumber])
  @@index([tenantId])
  @@map("banks")
}

model PatientDocumentType {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  code        String
  description String?
  isRequired  Boolean   @default(false)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?

  hospital Hospital @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("patient_document_types")
}

// ============================================
// PHASE 1.2 — DISCOUNT MASTERS (Tenant-scoped)
// ============================================

model DiscountReason {
  id                 String    @id @default(uuid())
  tenantId           String
  name               String // e.g., "Staff Welfare", "EWS / Poor Patient", "Doctor Discretion"
  code               String // e.g., "STAFF", "EWS", "DOC_DISC"
  description        String?
  maxDiscountPercent Decimal?  @db.Decimal(5, 2) // Optional ceiling cap for this specific reason
  isActive           Boolean   @default(true)
  deletedAt          DateTime?

  hospital Hospital @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("discount_reasons")
}

model DiscountApprovalAuthority {
  id                 String    @id @default(uuid())
  tenantId           String
  hospitalRoleId     Int
  maxDiscountPercent Decimal   @db.Decimal(5, 2) // Max % this role may approve on a bill
  maxDiscountAmount  Decimal?  @db.Decimal(12, 2) // Optional absolute cap per bill
  description        String?
  isActive           Boolean   @default(true)
  deletedAt          DateTime?

  hospital     Hospital     @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  hospitalRole HospitalRole @relation(fields: [hospitalRoleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, hospitalRoleId])
  @@index([tenantId])
  @@map("discount_approval_authorities")
}

model AssignedPackage {
  id        Int                     @id @default(autoincrement())
  tenantId  String
  packageId Int
  startDate DateTime
  endDate   DateTime?
  status    PackageAssignmentStatus @default(ACTIVE)

  hospital Hospital @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  package  Package  @relation(fields: [packageId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("assigned_packages")
}

// ============================================
// HIMS — USER & ROLE MANAGEMENT
// ============================================

model RoleName {
  id                Int     @id @default(autoincrement())
  name              String
  code              String  @unique
  description       String?
  isSystem          Boolean @default(false)
  createdByTenantId String?

  createdByHospital Hospital?      @relation(fields: [createdByTenantId], references: [tenantId])
  hospitalRoles     HospitalRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("role_names")
}

model HospitalRole {
  id         Int    @id @default(autoincrement())
  tenantId   String
  roleNameId Int

  description String?
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)

  hospital Hospital @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  roleName RoleName @relation(fields: [roleNameId], references: [id], onDelete: Restrict)

  permissions                 HospitalRolePermission[]
  users                       UserRoleAssignment[]
  discountApprovalAuthorities DiscountApprovalAuthority[]

  // === PHASE 1.3: AUDIT TRACKING ===
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, roleNameId])
  @@index([tenantId])
  @@map("hospital_roles")
}

model HospitalRolePermission {
  id             Int @id @default(autoincrement())
  hospitalRoleId Int
  moduleId       Int
  featureId      Int

  hospitalRole  HospitalRole  @relation(fields: [hospitalRoleId], references: [id], onDelete: Cascade)
  moduleFeature ModuleFeature @relation(fields: [moduleId, featureId], references: [moduleId, featureId], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([hospitalRoleId, moduleId, featureId])
  @@map("hospital_role_permissions")
}

model Department {
  id       Int    @id @default(autoincrement())
  tenantId String

  name        String
  code        String?
  isActive    Boolean @default(true)
  description String?

  hospital     Hospital                @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  users        UserDepartmentMapping[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("departments")
}

model ShiftMaster {
  id       Int    @id @default(autoincrement())
  tenantId String

  name      String
  startTime String?
  endTime   String?
  isActive  Boolean @default(true)

  hospital      Hospital       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  staffProfiles StaffProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("shift_masters")
}

model HospitalUser {
  id       String @id @default(uuid())
  tenantId String

  userType HospitalUserType @default(REGULAR_USER)

  firstName       String
  lastName        String?
  email           String
  mobile          String?
  alternateMobile String?

  username                String
  passwordHash            String
  loginType               LoginType          @default(PASSWORD)
  status                  HospitalUserStatus @default(ACTIVE)
  isTemporaryPassword     Boolean            @default(true)
  forcePasswordChange     Boolean            @default(true)
  twoFactorEnabled        Boolean            @default(false)
  // === SECURITY ADDITION START ===
  failedLoginAttempts     Int                @default(0) @map("failed_login_attempts")
  lockedUntil             DateTime?          @map("locked_until")
  passwordChangedAt       DateTime           @default(now()) @map("password_changed_at")
  sessions                AuthSession[]      @relation("HospitalSessions")
  loginOtps               LoginOtp[]         @relation("HospitalOtps")
  // === SECURITY ADDITION END ===
  sendCredentialsViaSms   Boolean            @default(false)
  sendCredentialsViaEmail Boolean            @default(false)
  accountValidTill        DateTime?
  refreshTokenHash        String?
  lastLoginAt             DateTime?

  hospital      Hospital                      @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  staffProfile  StaffProfile?
  roles         UserRoleAssignment[]
  departments   UserDepartmentMapping[]
  permissions   UserModuleFeaturePermission[]
  managedStaff  StaffProfile[]                @relation("ReportingManager")
  doctorProfile DoctorProfile?

  // Phase 2.2 — PRO ownership of external refer doctors
  assignedReferDoctors ReferDoctor[] @relation("ProReferDoctors")

  // Phase 2.4 Session 4 — lab sign-off matrix
  labSignoffAuthorities LabSignoffAuthority[]

  // === PHASE 1.3: AUDIT TRACKING ===
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("hospital_users")
}

model StaffProfile {
  id         Int    @id @default(autoincrement())
  userId     String @unique
  tenantId   String
  employeeId String

  title       String?
  dateOfBirth DateTime?
  gender      Gender?
  bloodGroup  String?

  designation   String?
  dateOfJoining DateTime?

  shiftId Int?

  reportingManagerId String?

  aadhaarNumber String?
  panNumber     String?

  address          String?
  city             String?
  state            String?
  pincode          String?
  emergencyContact String?

  user             HospitalUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift            ShiftMaster?  @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  reportingManager HospitalUser? @relation("ReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, employeeId])
  @@index([tenantId])
  @@map("staff_profiles")
}

model UserRoleAssignment {
  userId         String
  hospitalRoleId Int
  isPrimary      Boolean  @default(false)
  assignedAt     DateTime @default(now())

  user         HospitalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalRole HospitalRole @relation(fields: [hospitalRoleId], references: [id], onDelete: Cascade)

  @@id([userId, hospitalRoleId])
  @@index([hospitalRoleId])
  @@map("user_role_assignments")
}

model UserDepartmentMapping {
  userId       String
  departmentId Int

  user       HospitalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("user_department_mappings")
}

model UserModuleFeaturePermission {
  id        Int    @id @default(autoincrement())
  userId    String
  moduleId  Int
  featureId Int

  user          HospitalUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleFeature ModuleFeature @relation(fields: [moduleId, featureId], references: [moduleId, featureId], onDelete: Cascade)

  grantedAt DateTime @default(now())

  @@unique([userId, moduleId, featureId])
  @@index([userId])
  @@map("user_module_feature_permissions")
}

// ============================================
// DOCTOR SCHEDULING
// ============================================

model DoctorProfile {
  id             String @id @default(uuid())
  tenantId       String
  hospitalUserId String @unique

  specialization    String
  qualifications    String?
  medicalRegNo      String?
  consultationFee   Decimal @db.Decimal(10, 2)
  slotDurationMins  Int     @default(15)
  bufferTimeMins    Int     @default(0)
  maxPatientsPerDay Int?

  // === PHASE 2.2: DOCTOR SETUP ===
  clinicalDepartmentId String?
  specializationId     String?
  digitalSignatureUrl  String? // S3/Cloudinary URL or static file path
  doctorSharePercent   Decimal @default(0) @db.Decimal(5, 2)

  isActive Boolean @default(true)

  hospital     Hospital     @relation(fields: [tenantId], references: [tenantId])
  hospitalUser HospitalUser @relation(fields: [hospitalUserId], references: [id])

  // Phase 2.2 linkages
  clinicalDepartment ClinicalDepartment?     @relation(fields: [clinicalDepartmentId], references: [id], onDelete: SetNull)
  specializationRel    Specialization?         @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  opdVisitConfigs      DoctorOpdVisitConfig[]

  // IPD
  ipdAdmissions IpdAdmission[]

  // Phase 3.2 — package consults & consumption
  packageDoctorConsults PackageDoctorConsult[]
  packageConsumptions   PackageConsumption[]

  availabilities DoctorAvailability[]
  leaveBlocks    DoctorLeaveBlock[]

  // OPD Step 2
  appointments Appointment[]

  // OPD Step 3
  opdTokens OpdToken[]

  consultations Consultation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("doctor_profiles")
}

model DoctorAvailability {
  id              String @id @default(uuid())
  tenantId        String
  doctorProfileId String

  dayOfWeek      Int
  startTime      String
  endTime        String

  isActive       Boolean @default(true)

  hospital      Hospital      @relation(fields: [tenantId], references: [tenantId])
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorProfileId, dayOfWeek, startTime, endTime])
  @@index([tenantId, doctorProfileId])
  @@map("doctor_availabilities")
}

model DoctorLeaveBlock {
  id              String @id @default(uuid())
  tenantId        String
  doctorProfileId String

  blockDate DateTime @db.Date
  startTime String?
  endTime   String?
  reason    String?

  hospital      Hospital      @relation(fields: [tenantId], references: [tenantId])
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId, doctorProfileId, blockDate])
  @@map("doctor_leave_blocks")
}

// ============================================
// PHASE 2.2 — DOCTOR SETUP
// ============================================

// Clinical (medical) wings — distinct from admin `Department` (HR/Operations)
model ClinicalDepartment {
  id          String    @id @default(uuid())
  tenantId    String
  name        String    // e.g., "Cardiology", "Neurology", "Orthopaedics"
  code        String    // e.g., "CARD", "NEUR", "ORTHO"
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?

  hospital        Hospital         @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  specializations Specialization[]
  doctorProfiles  DoctorProfile[]
  packageDoctorConsults PackageDoctorConsult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("clinical_departments")
}

// Sub-specialty inside a clinical department (e.g., Cardiology → Interventional)
model Specialization {
  id                   String    @id @default(uuid())
  tenantId             String
  clinicalDepartmentId String
  name                 String    // e.g., "Interventional Cardiology", "Pediatric Cardiology"
  code                 String    // e.g., "INT_CARD", "PED_CARD"
  description          String?
  isActive             Boolean   @default(true)
  deletedAt            DateTime?

  hospital           Hospital           @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  clinicalDepartment ClinicalDepartment @relation(fields: [clinicalDepartmentId], references: [id], onDelete: Cascade)
  doctorProfiles     DoctorProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, clinicalDepartmentId])
  @@map("specializations")
}

// Follow-up & visit fee rules per doctor (general/cash or per panel)
model DoctorOpdVisitConfig {
  id                 String    @id @default(uuid())
  tenantId           String
  doctorProfileId    String
  panelId            String?   // null = General/Cash patients, or specific Panel
  firstVisitFee      Decimal   @db.Decimal(10, 2)
  followUpDays       Int       @default(7)  // Valid window for follow-up
  followUpMaxVisits  Int       @default(1)  // Number of free/discounted visits within window
  followUpFee        Decimal   @default(0) @db.Decimal(10, 2) // Typically ₹0 for follow-up
  emergencyFee       Decimal?  @db.Decimal(10, 2)
  isActive           Boolean   @default(true)
  deletedAt          DateTime?

  hospital      Hospital      @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  panel         Panel?        @relation(fields: [panelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, doctorProfileId, panelId])
  @@index([tenantId, doctorProfileId])
  @@map("doctor_opd_visit_configs")
}

// External doctors (private clinics) who refer patients + their PRO owner
model ReferDoctor {
  id                 String    @id @default(uuid())
  tenantId           String
  name               String    // Dr. Full Name
  code               String?   // e.g., "REF-001"
  clinicHospitalName String?   // Clinic or external hospital name
  mobile             String
  email              String?
  specialization     String?
  address            String?
  city               String?
  state              String?
  pincode            String?
  commissionPercent  Decimal   @default(0) @db.Decimal(5, 2)
  panNumber          String?
  bankAccountNo      String?
  ifscCode           String?
  proUserId          String?   // HospitalUser acting as PRO (Marketing executive)
  isActive           Boolean   @default(true)
  deletedAt          DateTime?

  hospital Hospital      @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  proUser  HospitalUser? @relation("ProReferDoctors", fields: [proUserId], references: [id], onDelete: SetNull)

  // Phase 2.2B — referral attribution
  referredPatients     Patient[]
  referredAppointments Appointment[]
  commissions          ReferralCommission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, mobile])
  @@index([tenantId, proUserId])
  @@map("refer_doctors")
}

// Phase 2.2B — referral incentive settlement tracking
model ReferralCommission {
  id               String    @id @default(uuid())
  tenantId         String
  referDoctorId    String
  appointmentId    String?
  patientId        String
  billId           String?   // Link to OpdBill when generated
  billAmount       Decimal   @db.Decimal(10, 2)  // Total bill amount
  commissionRate   Decimal   @db.Decimal(5, 2)   // Snapshot of ReferDoctor.commissionPercent at billing time
  commissionAmount Decimal   @db.Decimal(10, 2)  // billAmount * commissionRate / 100
  proUserId        String?   // Snapshot of PRO assigned at billing time
  status           String    @default("PENDING") // PENDING, APPROVED, PAID, CANCELLED
  settledAt        DateTime?
  settledBy        String?   // HospitalUser.id who approved payment
  notes            String?

  hospital    Hospital    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  referDoctor ReferDoctor @relation(fields: [referDoctorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, referDoctorId])
  @@index([tenantId, proUserId])
  @@index([tenantId, status])
  @@map("referral_commissions")
}

// ============================================
// PHASE 2.3 — WARD, ROOM & BED (IPD FOUNDATION)
// ============================================

enum BedStatusType {
  AVAILABLE
  RESERVED
  OCCUPIED
  DISCHARGE_PENDING
  HOUSEKEEPING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum WardGender {
  ANY
  MALE_ONLY
  FEMALE_ONLY
  PEDIATRIC
}

// RoomType — category of rooms/wards ("General Ward", "ICU", "Private Deluxe")
model RoomType {
  id             String       @id @default(uuid())
  tenantId       String
  name           String       // e.g., "General Ward", "Semi-Private", "Private Deluxe", "ICU", "NICU", "Daycare"
  code           String       // e.g., "GW", "SP", "PVT", "ICU", "NICU", "DC"
  description    String?
  isEmergency    Boolean      @default(false)  // true = bypass IPD admission wizard, go to ER triage
  isDaycare      Boolean      @default(false)  // true = cap stay at 24hrs, apply daycare package
  isDialysis     Boolean      @default(false)  // true = session-based billing, no bed rent
  isCount        Boolean      @default(true)   // false = excluded from BOR calculation (recovery, stretchers)
  defaultRate    Decimal      @default(0) @db.Decimal(10, 2)  // Base per-day bed charge
  nursingCharge  Decimal      @default(0) @db.Decimal(10, 2)  // Per-day nursing charge for this room type
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  deletedAt      DateTime?

  hospital Hospital @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  rooms    Room[]

  // Phase 1.4 — rate caps per room type (nullable side)
  thresholdLimits ThresholdLimit[]

  // Phase 3.2 — IPD packages valid in this room type
  packageMasters PackageMaster[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("room_types")
}

// Room — physical room/ward ("GW-1", "ICU-2", "301")
model Room {
  id             String       @id @default(uuid())
  tenantId       String
  roomTypeId     String
  roomNumber     String       // e.g., "GW-1", "ICU-2", "301", "302A"
  floor          String?      // e.g., "Ground", "1st", "2nd"
  wing           String?      // e.g., "East Wing", "Block A"
  gender         WardGender   @default(ANY)
  maxBeds        Int          @default(1)  // Expected capacity (informational)
  hasAC          Boolean      @default(false)
  hasAttachedBath Boolean     @default(false)
  hasTV          Boolean      @default(false)
  hasOxygen      Boolean      @default(false)
  hasMonitor     Boolean      @default(false)
  notes          String?
  isActive       Boolean      @default(true)
  deletedAt      DateTime?

  hospital  Hospital         @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  roomType  RoomType         @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  beds      Bed[]
  amenities RoomBedAmenity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, roomNumber])
  @@index([tenantId, roomTypeId])
  @@index([tenantId, gender])
  @@map("rooms")
}

// Bed — individual bed within a room
model Bed {
  id             String    @id @default(uuid())
  tenantId       String
  roomId         String
  bedNumber      String    // e.g., "01", "02", "A", "B"
  bedIdentifier  String    // Auto-generated: "{roomNumber}/{bedNumber}" e.g., "GW-1/01"
  isActive       Boolean   @default(true)
  deletedAt      DateTime?

  hospital Hospital @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  // 1:1 "current status" is derived via statusHistory { isCurrent: true } —
  // a separate FK would duplicate what the flag already guarantees.
  statusHistory BedStatus[] // Full audit trail

  ipdAdmissions IpdAdmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, bedIdentifier])
  @@unique([roomId, bedNumber])
  @@index([tenantId, roomId])
  @@map("beds")
}

// BedStatus — runtime state machine + full audit trail (isCurrent marks the live row)
model BedStatus {
  id             String        @id @default(uuid())
  tenantId       String
  bedId          String
  status         BedStatusType
  patientId      String?       // Link to Patient when OCCUPIED or RESERVED
  ipdAdmissionId String?       // Link to IPD Admission (future — keep as String for now)
  reservedBy     String?       // HospitalUser.id who reserved
  reason         String?       // e.g., "Admission via ER", "Post-surgery recovery", "Deep cleaning"
  changedBy      String?       // HospitalUser.id who changed status
  isCurrent      Boolean       @default(true)  // Only one record per bed should be isCurrent = true
  effectiveFrom  DateTime      @default(now())
  effectiveTo    DateTime?     // Null if current

  hospital     Hospital      @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  bed          Bed           @relation(fields: [bedId], references: [id], onDelete: Cascade)
  ipdAdmission IpdAdmission? @relation(fields: [ipdAdmissionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId, bedId, isCurrent])
  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@map("bed_statuses")
}

// BedAmenity — master list of amenities for filtering ("AC", "TV", "Fridge")
model BedAmenity {
  id       String    @id @default(uuid())
  tenantId String
  name     String    // e.g., "Air Conditioner", "Television", "Refrigerator", "Sofa for Attendant"
  code     String    // e.g., "AC", "TV", "FRIDGE", "SOFA"
  icon     String?   // UI icon identifier
  isActive Boolean   @default(true)

  hospital Hospital       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  rooms    RoomBedAmenity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("bed_amenities")
}

// RoomBedAmenity — many-to-many mapping (room ⇄ amenity)
model RoomBedAmenity {
  roomId      String
  amenityId   String
  room        Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenity     BedAmenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomId, amenityId])
  @@map("room_bed_amenities")
}

// ============================================
// IPD — ADMISSION / DISCHARGE WORKFLOW
// ============================================

model IpdAdmission {
  id              String    @id @default(uuid())
  tenantId        String
  admissionNo     String    // Auto: "IPD-{YYYY}-{00001}"
  patientId       String
  doctorProfileId String
  bedId           String?
  panelId         String?
  referDoctorId   String?

  admissionDate        DateTime  @default(now())
  admissionType        String    @default("EMERGENCY")  // EMERGENCY, PLANNED, TRANSFER, DAYCARE
  provisionalDiagnosis String?
  reasonForAdmission   String?
  expectedDischargeDate DateTime? @db.Date

  dischargeDate    DateTime?
  dischargeType    String?   // NORMAL, LAMA, TRANSFERRED, EXPIRED
  dischargeSummary String?
  dischargedBy     String?

  advancePaid        Decimal @default(0) @db.Decimal(10, 2)
  provisionalTotal   Decimal @default(0) @db.Decimal(15, 2)
  thresholdBreached  Boolean @default(false)
  thresholdAlertSent Boolean @default(false)

  status   String  @default("ADMITTED")  // ADMITTED, DISCHARGE_ORDERED, DISCHARGED, CANCELLED
  isActive Boolean @default(true)

  hospital      Hospital      @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  patient       Patient       @relation(fields: [patientId], references: [id])
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  bed           Bed?          @relation(fields: [bedId], references: [id], onDelete: SetNull)
  panel         Panel?        @relation(fields: [panelId], references: [id], onDelete: SetNull)
  bedStatuses   BedStatus[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, admissionNo])
  @@index([tenantId, patientId])
  @@index([tenantId, bedId])
  @@index([tenantId, status])
  @@index([tenantId, panelId])
  @@map("ipd_admissions")
}

// ============================================
// PHASE 2.4 — LAB / RADIO SETUP (LIS/RIS) — SESSION 1: CORE HIERARCHY
// ============================================

enum LabDepartmentType {
  BIOCHEMISTRY
  HEMATOLOGY
  MICROBIOLOGY
  PATHOLOGY
  SEROLOGY
  RADIOLOGY
  CARDIOLOGY
  NUCLEAR_MEDICINE
  OTHER
}

enum ObservationDataType {
  NUMERIC
  TEXT
  BOOLEAN
  SELECT
  CALCULATED
}

enum SpecimenType {
  BLOOD
  SERUM
  PLASMA
  URINE
  STOOL
  SPUTUM
  CSF
  SWAB
  TISSUE
  FLUID
  OTHER
}

enum InvestigationReportStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  APPROVED
  REJECTED
  AMENDED
}

// LabDepartment — lab sections/wings (Biochemistry, Hematology, X-Ray…)
model LabDepartment {
  id              String            @id @default(uuid())
  tenantId        String
  name            String            // e.g., "Biochemistry", "Hematology", "Radiology X-Ray"
  code            String            // e.g., "BIO", "HEM", "RAD_XR"
  departmentType  LabDepartmentType
  headUserId      String?           // HospitalUser.id — Lab in-charge
  location        String?           // e.g., "Ground Floor, Block A"
  turnaroundHours Int               @default(24)  // Default TAT in hours
  allowTemplates  Boolean           @default(true) // Whether to use rich-text report templates
  isActive        Boolean           @default(true)
  deletedAt       DateTime?

  hospital       Hospital        @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  investigations Investigation[]
  reportTemplates ReportTemplate[]
  reportComments  ReportComment[]
  signoffAuthorities LabSignoffAuthority[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("lab_departments")
}

// Investigation — billable test, linked to ServiceMaster (billing link)
model Investigation {
  id                  String                     @id @default(uuid())
  tenantId            String
  labDepartmentId     String
  serviceId           String                     // FK to ServiceMaster — this is the billing link
  name                String                     // e.g., "Lipid Profile", "CBC", "X-Ray Chest PA"
  code                String                     // e.g., "LIPID", "CBC", "XR_CHEST_PA"
  shortName           String?                    // e.g., "LP", "CBC"
  specimenType        SpecimenType               @default(BLOOD)
  specimenVolume      String?                    // e.g., "5ml", "10ml"
  containerColor      String?                    // e.g., "Red Top", "EDTA Purple"
  fastingRequired     Boolean                    @default(false)
  reportingFormat     String?                    // e.g., "NUMERIC_TABLE", "DESCRIPTIVE", "IMAGE"
  outsourceLabName    String?                    // If sent to external lab
  outsourceTatHours   Int?                       // External lab TAT
  // Session 3 — pre-analytical linkage
  sampleTypeId        String?
  sampleContainerId   String?
  // Session 4 — outsource reference lab
  outsourceLabId      String?
  isActive            Boolean                    @default(true)
  deletedAt           DateTime?

  hospital      Hospital      @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  labDepartment LabDepartment @relation(fields: [labDepartmentId], references: [id], onDelete: Cascade)
  service       ServiceMaster @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  sampleTypeRel       SampleType?            @relation(fields: [sampleTypeId], references: [id], onDelete: SetNull)
  sampleContainerRel  SampleContainerMaster? @relation(fields: [sampleContainerId], references: [id], onDelete: SetNull)
  outsourceLab        OutsourceLabMaster?    @relation(fields: [outsourceLabId], references: [id], onDelete: SetNull)

  observations InvestigationObservationMapping[]
  reportTemplates ReportTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, labDepartmentId])
  @@index([tenantId, serviceId])
  @@map("investigations")
}

// Observation — individual test parameter (Total Cholesterol, Hemoglobin, TSH)
model Observation {
  id               String            @id @default(uuid())
  tenantId         String
  name             String            // e.g., "Total Cholesterol", "Hemoglobin", "TSH"
  code             String            // e.g., "TCHOL", "HGB", "TSH"
  dataType         ObservationDataType @default(NUMERIC)
  unit             String?           // e.g., "mg/dL", "g/dL", "mIU/L"
  decimalPlaces    Int               @default(2)
  sortOrder        Int               @default(0)
  isCritical       Boolean           @default(false)  // Critical value alert flag
  selectOptions    String[]          // For dataType = SELECT: ["Negative", "Positive", "Trace"]
  formulaExpression String?          // For dataType = CALCULATED: "TCHOL - HDL - (TRIG/5)"
  isActive         Boolean           @default(true)
  deletedAt        DateTime?

  hospital       Hospital                          @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  investigations InvestigationObservationMapping[]
  referenceRanges ReferenceRange[]
  interpretations InvestigationInterpretation[]
  helps           ObservationHelp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("observations")
}

// InvestigationObservationMapping — many-to-many with ordering
model InvestigationObservationMapping {
  id              String    @id @default(uuid())
  investigationId String
  observationId   String
  sortOrder       Int       @default(0)  // Display order within the investigation report
  isMandatory     Boolean   @default(true) // Whether this observation must have a result
  isReportable    Boolean   @default(true) // Whether to show on final report

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  observation   Observation   @relation(fields: [observationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([investigationId, observationId])
  @@index([investigationId])
  @@index([observationId])
  @@map("investigation_observation_mappings")
}

// ReferenceRange — normal values by gender + age band
model ReferenceRange {
  id            String    @id @default(uuid())
  tenantId      String
  observationId String
  gender        Gender?   // null = applies to ALL genders
  minAgeYears   Int?      // null = no lower bound
  maxAgeYears   Int?      // null = no upper bound
  minValue      Decimal?  @db.Decimal(10, 4)  // Lower normal limit
  maxValue      Decimal?  @db.Decimal(10, 4)  // Upper normal limit
  normalText    String?   // For TEXT type observations: e.g., "Negative", "No growth"
  criticalLow   Decimal?  @db.Decimal(10, 4)  // Below this = critical alert
  criticalHigh  Decimal?  @db.Decimal(10, 4)  // Above this = critical alert
  isActive      Boolean   @default(true)

  hospital    Hospital    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, observationId])
  @@index([observationId, gender])
  @@map("reference_ranges")
}

// ============================================
// PHASE 2.4 — SESSION 2: TEMPLATES, INTERPRETATIONS, HELP & COMMENTS
// ============================================

enum TemplateType {
  NUMERIC_TABLE       // Standard lab results table (Biochemistry, Hematology)
  DESCRIPTIVE         // Paragraph-style report (Radiology, Pathology)
  CULTURE_SENSITIVITY // Microbiology C&S format
  FLOW_CYTOMETRY      // Specialized format
  CUSTOM              // Free-form HTML/Markdown
}

enum InterpretationCondition {
  ABOVE_MAX           // value > maxValue
  BELOW_MIN           // value < minValue
  ABOVE_CRITICAL_HIGH // value > criticalHigh
  BELOW_CRITICAL_LOW  // value < criticalLow
  EQUALS              // value == specific
  CONTAINS            // text contains keyword
  IN_RANGE            // value within normal (for flagging normal results)
}

// ReportTemplate — report format per department/investigation (or global)
model ReportTemplate {
  id                String       @id @default(uuid())
  tenantId          String
  labDepartmentId   String?      // null = global template
  investigationId   String?      // null = applies to all investigations in dept
  templateType      TemplateType @default(NUMERIC_TABLE)
  name              String       // e.g., "Biochemistry Standard", "X-Ray Report", "Culture & Sensitivity"
  headerHtml        String?      // HTML/Markdown for report header (hospital logo, patient info block)
  bodyHtml          String?      // HTML/Markdown for results body layout
  footerHtml        String?      // HTML/Markdown for footer (pathologist sign, disclaimer)
  cssStyles         String?      // Custom CSS for print layout
  isDefault         Boolean      @default(false)  // Default template for the department
  isActive          Boolean      @default(true)
  deletedAt         DateTime?

  hospital      Hospital       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  labDepartment LabDepartment? @relation(fields: [labDepartmentId], references: [id], onDelete: SetNull)
  investigation Investigation? @relation(fields: [investigationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, labDepartmentId])
  @@index([tenantId, investigationId])
  @@map("report_templates")
}

// InvestigationInterpretation — auto-interpretation rules per observation
model InvestigationInterpretation {
  id              String                @id @default(uuid())
  tenantId        String
  observationId   String
  condition       InterpretationCondition
  thresholdValue  Decimal?              @db.Decimal(10, 4)  // For ABOVE_MAX, BELOW_MIN, etc.
  thresholdText   String?               // For CONTAINS condition
  interpretationText String             // e.g., "Elevated — Suggestive of Hypothyroidism"
  severity        String                @default("INFO")    // INFO, WARNING, CRITICAL
  sortOrder       Int                   @default(0)
  isActive        Boolean               @default(true)

  hospital    Hospital    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, observationId])
  @@map("investigation_interpretations")
}

// ObservationHelp — data-entry guidance for lab technicians
model ObservationHelp {
  id            String    @id @default(uuid())
  tenantId      String
  observationId String
  helpTitle     String    // e.g., "Sample Collection", "Interference", "Clinical Significance"
  helpText      String    // Detailed help content
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)

  hospital    Hospital    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, observationId])
  @@map("observation_helps")
}

// ReportComment — standard comment library (one-click attach)
model ReportComment {
  id              String    @id @default(uuid())
  tenantId        String
  labDepartmentId String?   // null = global comment, available to all departments
  category        String    @default("GENERAL")  // GENERAL, SAMPLE_QUALITY, TECHNICAL, CLINICAL, DISCLAIMER
  commentText     String    // e.g., "Sample hemolyzed — results may be affected", "Repeat test advised"
  shortcut        String?   // Quick code: e.g., "HEM", "REP", "LIP"
  isActive        Boolean   @default(true)
  deletedAt       DateTime?

  hospital      Hospital       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  labDepartment LabDepartment? @relation(fields: [labDepartmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, shortcut])
  @@index([tenantId, labDepartmentId])
  @@index([tenantId, category])
  @@map("report_comments")
}

// ============================================
// PHASE 2.4 — SESSION 3: PRE-ANALYTICAL (CONTAINERS, SAMPLE TYPES, RETENTION)
// ============================================

enum StorageTemperature {
  ROOM_TEMPERATURE // 20°C - 25°C
  REFRIGERATED     // 2°C - 8°C
  FROZEN           // -20°C
  DEEP_FROZEN      // -80°C
}

// SampleContainerMaster — vacutainers, urine cups, swab tubes
model SampleContainerMaster {
  id              String    @id @default(uuid())
  tenantId        String
  name            String    // e.g., "EDTA Tube", "SST Gel Tube", "Sodium Citrate", "Fluoride Tube", "Plain Red Tube"
  code            String    // e.g., "EDTA_PURPLE", "SST_YELLOW", "CITRATE_BLUE", "FLUORIDE_GREY", "PLAIN_RED"
  capColor        String    // e.g., "Lavender", "Yellow/Gold", "Light Blue", "Grey", "Red", "Green"
  hexColorCode    String?   // Hex code for UI display e.g., "#9370DB", "#FFD700", "#87CEEB"
  additive        String?   // e.g., "K2 EDTA", "Clot Activator & Gel", "3.2% Sodium Citrate", "Sodium Fluoride + Potassium Oxalate"
  defaultVolumeMl Decimal?  @db.Decimal(4, 2) // e.g., 2.00, 3.00, 5.00 ml
  tubeType        String    @default("VACUTAINER") // VACUTAINER, STERILE_CUP, SWAB_TUBE, SLIDE_BOX
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  deletedAt       DateTime?

  hospital       Hospital         @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  sampleTypes    SampleType[]
  investigations Investigation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("sample_container_masters")
}

// SampleType — dynamic specimen master with stability + retention rules
model SampleType {
  id                      String              @id @default(uuid())
  tenantId                String
  name                    String              // e.g., "Whole Blood", "Serum", "Plasma", "Random Urine", "24hr Urine", "CSF", "Sputum"
  code                    String              // e.g., "WB", "SER", "PLA", "24URN", "CSF", "SPT"
  defaultContainerId      String?             // Preferred default tube
  minVolumeMl             Decimal?            @db.Decimal(4, 2)
  storageTemp             StorageTemperature  @default(REFRIGERATED)
  stabilityRoomTempHours  Int?                @default(4)   // How long stable at 20-25°C
  stabilityFridgeHours    Int?                @default(24)  // How long stable at 2-8°C
  stabilityFrozenDays     Int?                @default(30)  // How long stable at -20°C
  archiveDays             Int                 @default(2)   // Post-reporting retention days for re-testing
  collectionInstructions  String?             // e.g., "Early morning mid-stream catch", "Overnight fast"
  isActive                Boolean             @default(true)
  deletedAt               DateTime?

  hospital         Hospital               @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  defaultContainer SampleContainerMaster? @relation(fields: [defaultContainerId], references: [id], onDelete: SetNull)
  investigations   Investigation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("sample_types")
}

// ============================================
// PHASE 2.4 — SESSION 4: MICROBIOLOGY, OUTSOURCE LABS & SIGN-OFF AUTHORITY
// ============================================

enum OrganismType {
  BACTERIA_GRAM_POSITIVE
  BACTERIA_GRAM_NEGATIVE
  BACTERIA_AFB
  FUNGI
  PARASITE
  VIRUS
  OTHER
}

enum AntibioticClass {
  PENICILLINS
  CEPHALOSPORINS
  CARBAPENEMS
  FLUOROQUINOLONES
  AMINOGLYCOSIDES
  MACROLIDES
  GLYCOPEPTIDES
  TETRACYCLINES
  SULFONAMIDES
  OXAZOLIDINONES
  POLYMYXINS
  OTHER
}

enum AstResultType {
  SENSITIVE
  INTERMEDIATE
  RESISTANT
  NOT_TESTED
}

// OrganismMaster — pathogen catalog
model OrganismMaster {
  id          String       @id @default(uuid())
  tenantId    String
  name        String       // e.g., "Escherichia coli", "Staphylococcus aureus", "Klebsiella pneumoniae"
  code        String       // e.g., "ECOLI", "SAUR", "KPNEU"
  organismType OrganismType @default(BACTERIA_GRAM_NEGATIVE)
  description String?
  isCommon    Boolean      @default(true) // Highlights common pathogens in data entry
  isActive    Boolean      @default(true)
  deletedAt   DateTime?

  hospital       Hospital                    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  standardPanels OrganismAntibioticMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, organismType])
  @@map("organism_masters")
}

// AntibioticMaster — antibiotic catalog with potency details
model AntibioticMaster {
  id              String          @id @default(uuid())
  tenantId        String
  name            String          // e.g., "Amikacin", "Meropenem", "Vancomycin", "Ciprofloxacin"
  code            String          // e.g., "AK", "MEM", "VA", "CIP"
  antibioticClass AntibioticClass @default(OTHER)
  standardDosage  String?         // e.g., "15mg/kg/day", "1g IV Q8H"
  sortOrder       Int             @default(0)
  isActive        Boolean         @default(true)
  deletedAt       DateTime?

  hospital       Hospital                    @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  organismPanels OrganismAntibioticMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, antibioticClass])
  @@map("antibiotic_masters")
}

// OrganismAntibioticMapping — standard AST testing battery per pathogen
model OrganismAntibioticMapping {
  id           String    @id @default(uuid())
  organismId   String
  antibioticId String
  sortOrder    Int       @default(0)
  isFirstLine  Boolean   @default(true) // First-line testing drug vs Reserve/Second-line drug

  organism   OrganismMaster   @relation(fields: [organismId], references: [id], onDelete: Cascade)
  antibiotic AntibioticMaster @relation(fields: [antibioticId], references: [id], onDelete: Cascade)

  @@unique([organismId, antibioticId])
  @@index([organismId])
  @@index([antibioticId])
  @@map("organism_antibiotic_mappings")
}

// OutsourceLabMaster — external reference labs (Lal PathLabs, Agilus, Metropolis)
model OutsourceLabMaster {
  id            String    @id @default(uuid())
  tenantId      String
  labName       String    // e.g., "Dr. Lal PathLabs", "Agilus Diagnostics (SRL)", "Metropolis Healthcare"
  code          String    // e.g., "LAL", "AGILUS", "METRO"
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  city          String?
  portalUrl     String?   // External B2B portal login link
  courierPickupTime String? // e.g., "14:00 daily"
  isActive      Boolean   @default(true)
  deletedAt     DateTime?

  hospital       Hospital        @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  investigations Investigation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("outsource_lab_masters")
}

// LabSignoffAuthority — pathologist verification & digital signature matrix (NABL)
model LabSignoffAuthority {
  id              String         @id @default(uuid())
  tenantId        String
  hospitalUserId  String         // Doctor/Pathologist/Biochemist user
  labDepartmentId String?        // null = can sign for ALL lab departments
  designationText String         // e.g., "Consultant Pathologist (MD, DNB)", "Chief Microbiologist"
  medicalRegNo    String?        // Registration council number to print on report
  canVerify       Boolean        @default(true)  // Can mark status as VERIFIED
  canApproveLock  Boolean        @default(false) // Can give final signoff & LOCK report
  isActive        Boolean        @default(true)
  deletedAt       DateTime?

  hospital      Hospital       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  hospitalUser  HospitalUser   @relation(fields: [hospitalUserId], references: [id], onDelete: Cascade)
  labDepartment LabDepartment? @relation(fields: [labDepartmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, hospitalUserId, labDepartmentId])
  @@index([tenantId, hospitalUserId])
  @@map("lab_signoff_authorities")
}

// ============================================
// OPD — STEP 1: PATIENT REGISTRATION ✅
// ============================================

model Patient {
  id       String @id @default(uuid())
  tenantId String

  uhid String

  firstName     String
  lastName      String?
  dateOfBirth   DateTime?      @db.Date
  ageAtRegistration Int?
  ageUnit           String?       @default("years")

  gender        Gender
  bloodGroup    BloodGroup?
  maritalStatus MaritalStatus?
  photo         String?

  mobile          String
  alternateMobile String?
  email           String?

  address  String?
  city     String?
  district String?
  state    String?
  pincode  String?
  country  String? @default("India")

  aadhaarNumber String?
  panNumber     String?
  abhaId        String?

  guardianName     String?
  guardianRelation RelationType?
  guardianMobile   String?

  insurancePolicyNo  String?
  insuranceValidTill DateTime?

  allergies       String?
  chronicDiseases String?

  empId String?

  consultingDoctor String?
  department       String?

  // Phase 2.2B — external doctor who referred this patient
  referDoctorId String?

  // 🟢 ADD PANEL FOREIGN KEY (Proper Normalization)
  panelId        String?
  panelPolicyNo  String? // Insurance Card No / Corporate Emp ID
  panelValidTill DateTime? @db.Date

  // 🟢 ADD: Consent & Privacy (HIPAA / ABDM Compliance)
  consentToShare Boolean @default(true)
  privacyFlag    String? // Useful for "VIP", "CONFIDENTIAL", "RESTRICTED" tags

  mergedIntoPatientId String?
  mergedInto          Patient?  @relation("PatientMerge", fields: [mergedIntoPatientId], references: [id], onDelete: SetNull)
  mergedFrom          Patient[] @relation("PatientMerge")

  patientType  PatientType   @default(NEW)
  status       PatientStatus @default(ACTIVE)
  registeredAt DateTime      @default(now())
  registeredBy String?

  deletedAt DateTime?

  hospital Hospital @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  panel    Panel?   @relation(fields: [panelId], references: [id], onDelete: SetNull)

  // OPD Step 2
  appointments  Appointment[]
  vitalsRecords PatientVitals[]
  consultations Consultation[]

  bills OpdBill[]

  // Phase 2.2B — referral attribution
  referDoctor ReferDoctor? @relation(fields: [referDoctorId], references: [id], onDelete: SetNull)

  // IPD
  ipdAdmissions IpdAdmission[]

  // Phase 3.2 — package quota consumption
  packageConsumptions PackageConsumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, uhid])
  @@index([tenantId])
  @@index([tenantId, mobile])
  @@index([tenantId, abhaId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([tenantId, panelId]) // 🟢 ADD THIS INDEX
  @@map("patients")
}

// ============================================
// CORE: TENANT SEQUENCES (Universal Counter Table)
// ============================================

model TenantSequence {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  entityType String   @map("entity_type") // 'APPOINTMENT', 'UHID', 'BILL', 'TOKEN'
  scopeKey   String   @map("scope_key") // '20260825' (daily) or '2026' (yearly)
  lastValue  Int      @default(0) @map("last_value")
  updatedAt  DateTime @updatedAt @map("updated_at")

  hospital Hospital @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@unique([tenantId, entityType, scopeKey])
  @@index([tenantId, entityType])
  @@map("tenant_sequences")
}

// ============================================
// OPD — STEP 2: APPOINTMENT
// ============================================

model Appointment {
  id       String @id @default(uuid())
  tenantId String

  appointmentNo String

  patientId       String
  doctorProfileId String
  departmentId    Int?

  appointmentDate DateTime @db.Date
  slotStartTime   String?
  slotEndTime     String?

  appointmentType AppointmentType   @default(WALK_IN)
  visitType       VisitType         @default(NEW_VISIT)
  status          AppointmentStatus @default(BOOKED)
  priority        Int               @default(0)

  consultationFee Decimal @db.Decimal(10, 2)

  referredByDoctorName String?
  referralNote         String?

  // Phase 2.2B — referral attribution & follow-up flag
  referDoctorId    String?
  isFollowUpVisit  Boolean  @default(false)

  reasonForVisit String?
  notes          String?

  bookedAt    DateTime  @default(now())
  bookedBy    String?
  checkedInAt DateTime?
  checkedInBy String?

  cancelledAt  DateTime?
  cancelReason String?
  cancelledBy  String?

  deletedAt DateTime?

  // Relations
  hospital      Hospital      @relation(fields: [tenantId], references: [tenantId], onDelete: Restrict)
  patient       Patient       @relation(fields: [patientId], references: [id])
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id])
  department    Department?   @relation(fields: [departmentId], references: [id])
  referDoctor   ReferDoctor?  @relation(fields: [referDoctorId], references: [id], onDelete: SetNull)

  token        OpdToken?
  consultation Consultation?
  bills        OpdBill?

  vitalsRecords PatientVitals[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id]) //  Security: Enables composite tenant isolation
  @@unique([tenantId, appointmentNo])
  @@index([tenantId, appointmentDate])
  @@index([tenantId, doctorProfileId, appointmentDate])
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, doctorProfileId, appointmentDate, slotStartTime])
  @@index([tenantId, deletedAt])
  @@map("appointments")
}

// ============================================
// OPD — STEP 3: TOKEN / QUEUE MANAGEMENT ✅
// ============================================

model OpdToken {
  id       String @id @default(uuid())
  tenantId String

  appointmentId   String @unique
  doctorProfileId String

  tokenNumber      Int
  tokenDate        DateTime    @db.Date
  status           TokenStatus @default(WAITING)
  originalPosition Int?

  estimatedTime String?
  calledAt      DateTime?
  startedAt     DateTime?
  completedAt   DateTime?

  roomNo String?

  hospital      Hospital      @relation(fields: [tenantId], references: [tenantId])
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, doctorProfileId, tokenDate, tokenNumber])
  @@index([tenantId, doctorProfileId, tokenDate])
  @@index([tenantId, status])
  @@index([tenantId, tokenDate])
  @@map("opd_tokens")
}

// ============================================
// OPD — STEP 4: PATIENT VITALS ✅
// ============================================

model PatientVitals {
  id       String @id @default(uuid())
  tenantId String

  patientId String

  // Links to consultation AFTER doctor starts session
  // Null when nurse records vitals before consultation
  consultationId String?

  // Links to appointment for this visit
  appointmentId String?

  // ─── ANTHROPOMETRY ──────────────────────────────────────────────
  heightCm Decimal? @db.Decimal(5, 2) // 172.50 cm
  weightKg Decimal? @db.Decimal(5, 2) // 70.50 kg


  // ─── TEMPERATURE ────────────────────────────────────────────────
  temperatureF Decimal? @db.Decimal(4, 1) // 98.6°F

  // ─── CARDIOVASCULAR ─────────────────────────────────────────────
  bloodPressureSys Int? // Systolic  e.g., 120
  bloodPressureDia Int? // Diastolic e.g., 80
  pulseRate        Int? // beats/min e.g., 72

  // ─── RESPIRATORY ────────────────────────────────────────────────
  respiratoryRate Int? // breaths/min e.g., 16
  spo2            Decimal? @db.Decimal(4, 1) // 98.5%

  // ─── BLOOD SUGAR ────────────────────────────────────────────────
  bloodSugarFasting Decimal? @db.Decimal(5, 1) // mg/dL
  bloodSugarPP      Decimal? @db.Decimal(5, 1) // Post Prandial
  bloodSugarRandom  Decimal? @db.Decimal(5, 1) // Random

  // ─── PAIN ASSESSMENT ────────────────────────────────────────────
  painScore Int? // 0-10 (Visual Analog Scale)

  // ─── CLINICAL INPUT BY NURSE ────────────────────────────────────
  chiefComplaints String? // "Fever since 3 days, headache"
  notes           String?

  // ─── META ───────────────────────────────────────────────────────
  recordedBy String? // HospitalUser.id (nurse/staff)
  recordedAt DateTime @default(now())

  // ─── RELATIONS ──────────────────────────────────────────────────
  hospital Hospital @relation(fields: [tenantId], references: [tenantId])
  patient  Patient  @relation(fields: [patientId], references: [id])

  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, patientId])
  @@index([tenantId, appointmentId])
  @@index([tenantId, recordedAt])
  @@map("patient_vitals")
}

// ============================================
// OPD — STEP 5: CONSULTATION ✅
// ============================================

model Consultation {
  id       String @id @default(uuid())
  tenantId String

  // Format : CON-{YYYYMMDD}-{0001}
  // Example: CON-20250610-0001
  // Scope  : Per tenant, resets daily
  consultationNo String

  // ─── CORE LINKS ─────────────────────────────────────────────────
  appointmentId   String @unique
  patientId       String
  doctorProfileId String

  // ─── SUBJECTIVE (S in SOAP) ─────────────────────────────────────
  chiefComplaints  String?
  historyOfIllness String?
  pastHistory      String?
  familyHistory    String?
  personalHistory  String?

  // ─── OBJECTIVE (O in SOAP) ──────────────────────────────────────
  generalExamination  String?
  systemicExamination String?
  localExamination    String?

  // ─── ASSESSMENT (A in SOAP) ─────────────────────────────────────
  provisionalDiagnosis String?
  finalDiagnosis       String?
  icdCodes             String[]

  // ─── PLAN (P in SOAP) ──────────────────────────────────────────
  clinicalNotes       String?
  specialInstructions String?

  // ─── FOLLOW-UP ──────────────────────────────────────────────────
  followUpDate  DateTime? @db.Date
  followUpNotes String?

  // ─── REFERRAL ───────────────────────────────────────────────────
  referredToDoctorId   String?
  referredToDepartment String?
  referralReason       String?

  // ─── STATUS & TIMING ───────────────────────────────────────────
  status      ConsultationStatus @default(IN_PROGRESS)
  startedAt   DateTime           @default(now())
  completedAt DateTime?

  isSigned Boolean   @default(false)
  signedAt DateTime?
  signedBy String? // UUID of the doctor who signed/locked it

  // ─── RELATIONS ──────────────────────────────────────────────────
  hospital      Hospital      @relation(fields: [tenantId], references: [tenantId])
  appointment   Appointment   @relation(fields: [appointmentId], references: [id])
  patient       Patient       @relation(fields: [patientId], references: [id])
  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id])

  prescriptions  Prescription[]
  investigations InvestigationOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, consultationNo])
  @@index([tenantId, patientId])
  @@index([tenantId, doctorProfileId])
  @@index([tenantId, appointmentId])
  @@index([tenantId, startedAt])
  @@map("consultations")
}

// ============================================
// OPD — STEP 5: PRESCRIPTION ✅
// ============================================

model Prescription {
  id       String @id @default(uuid())
  tenantId String

  consultationId String

  // ─── MEDICINE IDENTIFICATION ────────────────────────────────────
  medicineName String
  genericName  String?
  medicineType String? // Tablet | Capsule | Syrup | Injection | Drop | Cream | Ointment

  // ─── DOSAGE ─────────────────────────────────────────────────────
  doseAmount      Decimal? @db.Decimal(10, 2) // e.g., 500
  doseUnit        String?                     // e.g., "mg", "ml", "drops"
  frequency       PrescriptionFrequency @default(TWICE_DAILY)
  customFrequency String? // Only if frequency = CUSTOM
  route           MedicineRoute         @default(ORAL)
  mealRelation    MealRelation          @default(AFTER_FOOD)

  // ─── DURATION ───────────────────────────────────────────────────
  durationDays  Int?
  durationWeeks Int?
  quantity      Int? // Total qty to dispense

  // ─── INSTRUCTIONS ──────────────────────────────────────────────
  instructions String?
  isCritical   Boolean @default(false)

  // ─── DISPLAY ORDER ─────────────────────────────────────────────
  sortOrder Int @default(0)

  // ─── RELATIONS ──────────────────────────────────────────────────
  hospital     Hospital     @relation(fields: [tenantId], references: [tenantId])
  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, consultationId])
  @@map("prescriptions")
}

// ============================================
// OPD — STEP 5: INVESTIGATION ORDER ✅
// ============================================

model InvestigationOrder {
  id       String @id @default(uuid())
  tenantId String

  consultationId String

  // ─── INVESTIGATION DETAILS ─────────────────────────────────────
  serviceId String

  investigationType InvestigationType @default(LAB)

  // ─── ORDER DETAILS ─────────────────────────────────────────────
  urgency       InvestigationUrgency @default(ROUTINE)
  instructions  String?
  clinicalNotes String?

  // ─── STATUS TRACKING ───────────────────────────────────────────
  status      InvestigationStatus @default(ORDERED)
  orderedAt   DateTime            @default(now())
  completedAt DateTime?

  // ─── RESULT (Basic — full result in Lab module) ────────────────
  resultSummary String?
  resultFile    String?

  sortOrder Int @default(0)

  // ─── RELATIONS ──────────────────────────────────────────────────
  service ServiceMaster @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  hospital     Hospital     @relation(fields: [tenantId], references: [tenantId])
  consultation Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, consultationId])
  @@index([tenantId, status])
  @@index([tenantId, serviceId])
  @@map("investigation_orders")
}

// ============================================
// OPD — STEP 6: OPD BILLING ✅
// ============================================

model OpdBill {
  id       String @id @default(uuid())
  tenantId String

  billNo String

  patientId     String
  appointmentId String? @unique

  // ─── CALCULATION ────────────────────────────────────────────────
  subtotal        Decimal @db.Decimal(10, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal @default(0) @db.Decimal(10, 2)
  taxPercent      Decimal @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal @db.Decimal(10, 2)
  paidAmount      Decimal @default(0) @db.Decimal(10, 2)
  dueAmount       Decimal @default(0) @db.Decimal(10, 2)

  // ─── STATUS ─────────────────────────────────────────────────────
  paymentStatus PaymentStatus @default(PENDING)
  paymentMode   PaymentMode?
  billStatus    BillStatus    @default(DRAFT)

  // ─── INSURANCE ──────────────────────────────────────────────────
  isInsurance       Boolean  @default(false)
  insuranceProvider String?
  insurancePolicyNo String?
  insuranceClaimed  Decimal? @db.Decimal(10, 2)
  insuranceApproved Decimal? @db.Decimal(10, 2)

  // ─── PHASE 3.1: PANEL LINKAGE ───────────────────────────────────
  panelId String?

  // ─── DISCOUNT AUTHORIZATION ─────────────────────────────────────
  discountReason       String?
  discountAuthorizedBy String?

  // ─── META ───────────────────────────────────────────────────────
  generatedBy  String?
  billedAt     DateTime  @default(now())
  paidAt       DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  // ─── RELATIONS ──────────────────────────────────────────────────
  hospital    Hospital     @relation(fields: [tenantId], references: [tenantId])
  patient     Patient      @relation(fields: [patientId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  panel       Panel?       @relation(fields: [panelId], references: [id], onDelete: SetNull)

  items    OpdBillItem[]
  payments OpdPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, billNo])
  @@index([tenantId, patientId])
  @@index([tenantId, billStatus])
  @@index([tenantId, billedAt])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, panelId])
  @@map("opd_bills")
}

// ============================================
// OPD — STEP 6.1: OPD BILL LINE ITEMS ✅
// ============================================

model OpdBillItem {
  id       String @id @default(uuid())
  tenantId String

  billId String

  // ─── ITEM DETAILS ───────────────────────────────────────────────
  itemCode String? // Links to future Service/Charge Master (e.g., LAB01)
  itemName String // Description of the service
  category String // 'Consultation', 'Lab', 'Pharmacy', 'Procedure'

  // ─── PHASE 2.1: SERVICE MASTER LINK ─────────────────────────────
  serviceId String?

  // ─── FINANCIALS ─────────────────────────────────────────────────
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(10, 2)
  quantity    Int     @default(1)


  unitPrice   Decimal @db.Decimal(10, 2)
  taxPercent  Decimal @default(0) @db.Decimal(5, 2)
  totalAmount Decimal @db.Decimal(10, 2) // quantity * unitPrice

  // ─── RELATIONS ──────────────────────────────────────────────────
  hospital Hospital       @relation(fields: [tenantId], references: [tenantId])
  bill     OpdBill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  service  ServiceMaster? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, billId])
  @@index([serviceId])
  @@map("opd_bill_items")
}

// ============================================
// OPD — STEP 6: OPD PAYMENT ✅
// ============================================

model OpdPayment {
  id       String @id @default(uuid())
  tenantId String

  billId String

  // Format : RCP-{YYYYMMDD}-{0001}
  receiptNo     String
  amount        Decimal     @db.Decimal(10, 2)
  paymentMode   PaymentMode
  transactionId String?
  status        PaymentStatus @default(PAID)

  receivedBy String?
  paidAt     DateTime @default(now())
  notes      String?

  // ─── RELATIONS ──────────────────────────────────────────────────
  hospital Hospital @relation(fields: [tenantId], references: [tenantId])
  bill     OpdBill  @relation(fields: [billId], references: [id])

  createdAt DateTime @default(now())

  @@unique([tenantId, receiptNo])
  @@index([tenantId, billId])
  @@map("opd_payments")
}

// ============================================
// AUDIT
// ============================================

model AuditLog {
  id       Int     @id @default(autoincrement())
  tenantId String?

  userId    String?
  patientId String?   
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// === SECURITY ADDITION START ===
model AuthSession {
  id             String        @id @default(uuid())
  platformUserId String?       @map("platform_user_id")
  hospitalUserId String?       @map("hospital_user_id")
  deviceName     String?       @map("device_name")
  userAgent      String?       @map("user_agent")
  ipAddress      String?       @map("ip_address")
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at")
  lastSeenAt     DateTime      @default(now()) @map("last_seen_at")
  expiresAt      DateTime      @map("expires_at")
  platformUser   PlatformUser? @relation("PlatformSessions", fields: [platformUserId], references: [id], onDelete: Cascade)
  hospitalUser   HospitalUser? @relation("HospitalSessions", fields: [hospitalUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId, isActive])
  @@index([hospitalUserId, isActive])
  @@map("auth_sessions")
}

model LoginOtp {
  id             String        @id @default(uuid())
  platformUserId String?       @map("platform_user_id")
  hospitalUserId String?       @map("hospital_user_id")
  otpHash        String        @map("otp_hash")
  attempts       Int           @default(0)
  expiresAt      DateTime      @map("expires_at")
  lastSentAt     DateTime      @default(now()) @map("last_sent_at")
  platformUser   PlatformUser? @relation("PlatformOtps", fields: [platformUserId], references: [id], onDelete: Cascade)
  hospitalUser   HospitalUser? @relation("HospitalOtps", fields: [hospitalUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId, expiresAt])
  @@index([hospitalUserId, expiresAt])
  @@map("login_otps")
}

// === SECURITY ADDITION END ===

// ============================================
// ENUMS — GLOBAL MASTER CONFIGURATION
// ============================================

enum MasterCategory {
  PANEL_BILLING
  CLINICAL
  INVENTORY
  GENERAL
}

enum MasterValueType {
  // --- PANEL / BILLING ---
  GROUP_TYPE
  PAYMENT_MODE
  RATE_TYPE
  CURRENCY
  PANEL_TYPE
  TAX_TYPE
  DISCOUNT_REASON
  REFUND_REASON
  CANCELLATION_REASON

  // --- CLINICAL ---
  CONSULTATION_TYPE
  DIAGNOSIS_TYPE
  DIET_TYPE
}

// ============================================
// MODEL — GLOBAL MASTER
// ============================================

model GlobalMaster {
  id       String @id @default(uuid())
  tenantId String

  category MasterCategory
  type     MasterValueType
  value    String

  isSystem  Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  deletedAt DateTime?

  hospital             Hospital @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  panelsAsGroupType    Panel[]  @relation("PanelGroupType")
  panelsAsPaymentMode  Panel[]  @relation("PanelPaymentMode")
  panelsAsPanelType    Panel[]  @relation("PanelType")
  panelsAsRateCurrency Panel[]  @relation("PanelRateCurrency")
  panelsAsBillCurrency Panel[]  @relation("PanelBillCurrency")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, type, value])
  @@index([tenantId, category])
  @@index([tenantId, type])
  @@index([tenantId, deletedAt])
  @@map("global_masters")
}

// ============================================
// ENUMS FOR PANEL MASTER LOGIC
// ============================================

enum CoPaymentOn {
  ON_BILL
  ON_SERVICE
  NONE
}

// ============================================
// MODEL — PANEL MASTER
// ============================================

model Panel {
  id       String @id @default(uuid())
  tenantId String

  // ─── BASIC DETAILS ──────────────────────────────────────────
  panelCode String
  panelName String

  // Relations to GlobalMaster Table (Using UUIDs instead of hardcoded Enums)
  groupTypeId   String?
  paymentModeId String?
  panelTypeId   String?

  contactPerson String?
  address1      String?
  address2      String?
  contactNo     String?
  phoneNo       String?
  email         String?
  faxNo         String?

  // ─── VALIDITY & CREDIT ──────────────────────────────────────
  validFrom   DateTime? @db.Date
  validTo     DateTime? @db.Date
  creditLimit Decimal   @default(0) @db.Decimal(15, 2)

  // ─── REFER RATES (Will link to Tariff Master later) ─────────
  opdTariffId String? // ID of Tariff
  ipdTariffId String? // ID of Tariff

  // ─── FLAGS (Checkboxes from UI) ─────────────────────────────
  rateTypeSelfOpd Boolean @default(false)
  rateTypeSelfIpd Boolean @default(false)
  showPrintout    Boolean @default(true) // Default 'Yes' in UI
  hideRate        Boolean @default(false) // Default 'No' in UI
  coverNote       Boolean @default(false) // Default 'No' in UI
  isSmartCard     Boolean @default(false) // Default 'No' in UI
  hasEncounter    Boolean @default(false) // Default unchecked in UI
  isUsdBased      Boolean @default(false) // Default unchecked in UI

  dietTypePrivate Boolean @default(false) // true = Private, false = Normal

  // ─── CO-PAYMENT & CURRENCY ──────────────────────────────────
  coPaymentOn      CoPaymentOn @default(NONE)
  coPaymentPercent Decimal     @default(0) @db.Decimal(5, 2)

  rateCurrencyId String? // Relation to GlobalMaster
  billCurrencyId String? // Relation to GlobalMaster
  currencyConv   Decimal @default(1) @db.Decimal(10, 4)

  panelAmount Decimal? @db.Decimal(15, 2)

  // ─── STATUS & AUDIT ─────────────────────────────────────────
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  patients Patient[]

  // Phase 2.2 — panel-specific doctor visit rules
  doctorOpdVisitConfigs DoctorOpdVisitConfig[]

  // Phase 1.4 + IPD
  thresholdLimits ThresholdLimit[]
  ipdAdmissions   IpdAdmission[]

  // Phase 3.1 — corporate/embassy & insurance workflow
  counsellorAddress       String?   // For international/embassy patients
  embassyAddress          String?
  authorizationRequired   Boolean   @default(false) // Pre-approval needed before service delivery
  preAuthRequired         Boolean   @default(false) // Cashless pre-authorization required
  claimSubmissionDays     Int       @default(30)    // Deadline in days to submit claim post-discharge

  rateSchedules  RateSchedule[]
  panelDocuments PanelDocument[]
  opdBills       OpdBill[]

  opdTariff TariffMaster? @relation("PanelOpdTariff", fields: [opdTariffId], references: [id])
  ipdTariff TariffMaster? @relation("PanelIpdTariff", fields: [ipdTariffId], references: [id])

  // ─── RELATIONS ──────────────────────────────────────────────
  hospital Hospital @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  // Links to Global Master for Dynamic Dropdowns
  groupType    GlobalMaster? @relation("PanelGroupType", fields: [groupTypeId], references: [id])
  paymentMode  GlobalMaster? @relation("PanelPaymentMode", fields: [paymentModeId], references: [id])
  panelType    GlobalMaster? @relation("PanelType", fields: [panelTypeId], references: [id])
  rateCurrency GlobalMaster? @relation("PanelRateCurrency", fields: [rateCurrencyId], references: [id])
  billCurrency GlobalMaster? @relation("PanelBillCurrency", fields: [billCurrencyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, panelCode])
  @@unique([tenantId, panelName])
  @@index([tenantId, groupTypeId])
  @@index([tenantId, isActive])
  @@map("panels")
}

// ============================================
// PHASE 1.4 — THRESHOLD LIMIT MASTER
// ============================================
// Max allowed running bill for a panel (optionally per room type).
// roomTypeId = NULL → general limit for the panel across all room types.

model ThresholdLimit {
  id             String    @id @default(uuid())
  tenantId       String
  panelId        String
  roomTypeId     String?   // null = applies to ALL room types for this panel
  maxAmount      Decimal   @db.Decimal(15, 2)
  alertAtPercent Decimal   @default(80) @db.Decimal(5, 2)
  actionOnBreach String    @default("SOFT")    // "SOFT" = warning, "HARD" = block charges
  isActive       Boolean   @default(true)
  deletedAt      DateTime?

  hospital Hospital  @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  panel    Panel     @relation(fields: [panelId], references: [id], onDelete: Cascade)
  roomType RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, panelId, roomTypeId])
  @@index([tenantId, panelId])
  @@map("threshold_limits")
}

// ============================================
// PHASE 3.1 — PANEL RATE SCHEDULES & CLAIM DOCUMENTS
// ============================================

// RateSchedule — time-bound tariff rate lists (CGHS 2024 vs CGHS 2026)
model RateSchedule {
  id            String    @id @default(uuid())
  tenantId      String
  panelId       String
  tariffId      String    // The TariffMaster rate list active during this period
  scheduleName  String    // e.g., "CGHS Rates 2024-2025", "Star Health Revised Q1 2026"
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date // null = indefinitely active until next revision
  isDefault     Boolean   @default(false) // Fallback schedule if no date matches
  notes         String?
  isActive      Boolean   @default(true)
  deletedAt     DateTime?

  hospital Hospital     @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  panel    Panel        @relation(fields: [panelId], references: [id], onDelete: Cascade)
  tariff   TariffMaster @relation(fields: [tariffId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, panelId, effectiveFrom])
  @@index([tenantId, isActive])
  @@map("rate_schedules")
}

// PanelDocument — required insurance claim documents & blank templates
model PanelDocument {
  id              String    @id @default(uuid())
  tenantId        String
  panelId         String
  documentName    String    // e.g., "TPA Pre-Authorization Form", "Claim Form B", "Implant Barcode Sticker Sheet"
  documentCode    String    // e.g., "PRE_AUTH_FORM", "CLAIM_FORM_B", "IMPLANT_STICKER"
  description     String?
  templateFileUrl String?   // S3/Cloudinary/Local URL for blank printable PDF/template
  isMandatory     Boolean   @default(true) // Whether claim submission is blocked without this document
  appliesToOpd    Boolean   @default(false)
  appliesToIpd    Boolean   @default(true)
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  deletedAt       DateTime?

  hospital Hospital @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  panel    Panel    @relation(fields: [panelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, panelId, documentCode])
  @@index([tenantId, panelId])
  @@map("panel_documents")
}

// ============================================
// PHASE 3.2 — PACKAGE SETUP (OPD HEALTH CHECKS & IPD BUNDLES)
// ============================================

enum PackageType {
  OPD_HEALTH_CHECK
  IPD_SURGERY
  DAYCARE_PROCEDURE
  CUSTOM_BUNDLE
}

enum ConsultTypeInPackage {
  OPD_VISIT
  IPD_DOCTOR_ROUND
  CROSS_CONSULTATION
}

// PackageMaster — bundle definition + auto-linked billing SKU
model PackageMaster {
  id               String       @id @default(uuid())
  tenantId         String
  serviceId        String?      @unique // Auto-linked SKU in ServiceMaster for billing
  name             String       // e.g., "Executive Health Checkup", "Laparoscopic Cholecystectomy", "Normal Delivery"
  code             String       // e.g., "PKG-EHC", "PKG-LAP-CHOL", "PKG-NVD"
  packageType      PackageType  @default(OPD_HEALTH_CHECK)
  roomTypeId       String?      // Optional: For IPD packages, valid room type (e.g., General Ward)
  includedStayDays Int?         @default(0) // Included hospitalization days (e.g., 3 days for surgery)
  basePrice        Decimal      @db.Decimal(10, 2) // Standard hospital price
  validityDays     Int          @default(30) // For OPD packages (validity window)
  description      String?
  isActive         Boolean      @default(true)
  deletedAt        DateTime?

  hospital   Hospital       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  roomType   RoomType?      @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  serviceSku ServiceMaster? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  components     PackageComponent[]
  doctorConsults PackageDoctorConsult[]
  exclusions     PackageExclusion[]
  consumptions   PackageConsumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, packageType])
  @@map("package_masters")
}

// PackageComponent — services/investigations included in the bundle (with quota)
model PackageComponent {
  id          String   @id @default(uuid())
  tenantId    String
  packageId   String
  serviceId   String   // FK to ServiceMaster (Lab test, Radiology, Nursing, OT charge)
  quantity    Int      @default(1) // Allowed quota included in package (e.g., 2 CBCs)
  isOptional  Boolean  @default(false)
  sortOrder   Int      @default(0)

  hospital Hospital      @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  package  PackageMaster @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service  ServiceMaster @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([packageId, serviceId])
  @@index([tenantId, packageId])
  @@map("package_components")
}

// PackageDoctorConsult — doctor visits/consultation allowance
model PackageDoctorConsult {
  id                   String               @id @default(uuid())
  tenantId             String
  packageId            String
  clinicalDepartmentId String?              // Optional: e.g., "Cardiology"
  doctorProfileId      String?              // Optional: Specific doctor if named package
  consultType          ConsultTypeInPackage @default(OPD_VISIT)
  maxVisits            Int                  @default(1) // Number of visits allowed

  hospital           Hospital            @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  package            PackageMaster       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  clinicalDepartment ClinicalDepartment? @relation(fields: [clinicalDepartmentId], references: [id], onDelete: SetNull)
  doctorProfile      DoctorProfile?      @relation(fields: [doctorProfileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId, packageId])
  @@map("package_doctor_consults")
}

// PackageExclusion — legal & billing exclusions printed on the package
model PackageExclusion {
  id            String    @id @default(uuid())
  tenantId      String
  packageId     String
  exclusionText String    // e.g., "Cost of Implants, Mesh, Staplers", "High-end antibiotics (Meropenem, Colistin)"
  sortOrder     Int       @default(0)

  hospital Hospital      @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  package  PackageMaster @relation(fields: [packageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId, packageId])
  @@map("package_exclusions")
}

// PackageConsumption — runtime usage tracking against quota
model PackageConsumption {
  id               String    @id @default(uuid())
  tenantId         String
  packageId        String
  patientId        String
  serviceId        String?   // Service consumed (if test/procedure)
  doctorProfileId  String?   // Doctor consulted (if doctor visit)
  consumedQuantity Int       @default(1)
  isExtraBilled    Boolean   @default(false) // true = over-consumption, billed at standard tariff rate
  billId           String?   // Link to OpdBill / IpdBill
  notes            String?
  consumedAt       DateTime  @default(now())

  hospital      Hospital       @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  package       PackageMaster  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  service       ServiceMaster? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  doctorProfile DoctorProfile? @relation(fields: [doctorProfileId], references: [id], onDelete: SetNull)

  @@index([tenantId, packageId, patientId])
  @@index([tenantId, patientId])
  @@map("package_consumptions")
}

// ============================================
// ENUMS FOR SERVICES SETUP & RATE MANAGEMENT
// ============================================

enum ServiceStoreType {
  NONE
  MEDICAL
  GENERAL
}

enum ServiceItemType {
  OPD
  IPD
  DAYCARE
  BOTH
  PACKAGE
}

// ============================================
// PHASE 2.1 — SERVICE CATEGORY (Tier 1)
// ============================================
// Broad classification: "Diagnostics / Lab", "Consultations",
// "Procedures", "Room Charges". Replaces the old rigid ServiceCategory enum
// with a dynamic tenant-scoped master.

model ServiceCategoryMaster {
  id          String           @id @default(uuid())
  tenantId    String
  name        String           // e.g. "Diagnostics / Lab", "Consultations", "Procedures", "Room Charges"
  code        String           // e.g. "DIAG", "CONS", "PROC", "ROOM"
  storeType   ServiceStoreType @default(NONE)
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  deletedAt   DateTime?

  hospital       Hospital             @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  subCategories  ServiceSubCategory[]
  services       ServiceMaster[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("service_category_masters")
}

// ============================================
// PHASE 2.1 — SERVICE SUB-CATEGORY (Tier 2)
// ============================================
// Specific clinical wing: "Biochemistry", "Hematology", "Minor OT".
// Print order + invoice grouping is controlled here.

model ServiceSubCategory {
  id          String    @id @default(uuid())
  tenantId    String
  categoryId  String
  name        String    // e.g. "Biochemistry", "Hematology", "Minor OT", "Cardiology"
  code        String    // e.g. "BIO", "HEM", "MOT", "CARD"
  displayName String?   // Name to be printed on final bills
  printOrder  Int       @default(0)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?

  hospital Hospital              @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  category ServiceCategoryMaster @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  services ServiceMaster[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId, categoryId])
  @@map("service_sub_categories")
}

// ============================================
// 1. SERVICE MASTER (Hospital ki saari services) — Tier 3
// ============================================
model ServiceMaster {
  id       String @id @default(uuid())
  tenantId String

  serviceCode String // e.g., LAB-001
  serviceName String // e.g., "Complete Blood Count (CBC)"

  // Hospital ka Standard/Base Rate
  baseRate Decimal @db.Decimal(10, 2)

  // === PHASE 2.1: SERVICES SETUP ===
  categoryId        String?
  subCategoryId     String?
  itemType          ServiceItemType @default(BOTH)
  hsnSacCode        String?         // GST/Tax classification code
  uom               String?         // Unit of measure e.g., "Per Test", "Per Hour", "Per Session"
  rateEditable      Boolean         @default(false) // Billing counter par rate change allowed?
  discountable      Boolean         @default(true)  // Discount allowed on this service?
  genderRestriction Gender?         // e.g., Pap Smear = FEMALE only
  minAgeYears       Int?            // e.g., Phototherapy = pediatric
  maxAgeYears       Int?

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  hospital            Hospital               @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  categoryRel         ServiceCategoryMaster? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subCategoryRel      ServiceSubCategory?    @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  panelRates          PanelServiceRate[] // Linking to tariff rates
  investigationOrders InvestigationOrder[]
  billItems           OpdBillItem[]
  investigations      Investigation[] // Phase 2.4 — LIS billing link

  // Phase 3.2 — package SKU linkage
  packageMaster       PackageMaster?
  packageComponents   PackageComponent[]
  packageConsumptions PackageConsumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, serviceCode])
  @@index([tenantId, categoryId])
  @@index([tenantId, subCategoryId])
  @@map("service_masters")
}

// ============================================
// 2. TARIFF MASTER (Rate Lists e.g., CGHS, Star Health)
// ============================================
model TariffMaster {
  id       String @id @default(uuid())
  tenantId String

  tariffCode String // e.g., TRF-001
  tariffName String // e.g., "CGHS 2024 Rate List"

  isActive  Boolean   @default(true)
  deletedAt DateTime?

  hospital Hospital           @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  rates    PanelServiceRate[]

  // Relations linking back to Panel (OPD & IPD Rates)
  opdPanels Panel[] @relation("PanelOpdTariff")
  ipdPanels Panel[] @relation("PanelIpdTariff")

  // Phase 3.1 — time-bound schedule usage
  rateSchedules RateSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, tariffCode])
  @@index([tenantId, isActive])
  @@map("tariff_masters")
}

// ============================================
// 3. PANEL SERVICE RATE (The actual Override Pricing)
// ============================================
model PanelServiceRate {
  id       String @id @default(uuid())
  tenantId String

  tariffId  String
  serviceId String

  // Overridden Rate for THIS specific tariff
  rate Decimal @db.Decimal(10, 2)

  // Optional Discount instead of flat rate
  discountPercent Decimal @default(0) @db.Decimal(5, 2)

  isActive Boolean @default(true)

  hospital Hospital      @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
  tariff   TariffMaster  @relation(fields: [tariffId], references: [id], onDelete: Cascade)
  service  ServiceMaster @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ek tariff me ek service ka ek hi rate ho sakta hai
  @@unique([tariffId, serviceId])
  @@index([tenantId, tariffId])
  @@map("panel_service_rates")
}
