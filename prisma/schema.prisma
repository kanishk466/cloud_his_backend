generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- ENUMS ----------

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT
}

enum HospitalStatus {
  DRAFT
  ACTIVE
  SUSPENDED
}

enum PackageAssignmentStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum HospitalUserStatus {
  ACTIVE
  INACTIVE
}

enum HospitalUserType {
  SUPER_ADMIN
  REGULAR_USER
}

enum LoginType {
  PASSWORD
  OTP
  BOTH
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ============================================
// PLATFORM SIDE (Minimal Admin Only)
// ============================================

model PlatformUser {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  firstName     String
  lastName      String?
  status        UserStatus     @default(ACTIVE)
  role          PlatformRole   @default(PLATFORM_ADMIN)

  refreshTokens RefreshToken[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("platform_users")
}

model RefreshToken {
  id        String       @id @default(uuid())
  token     String
  expiresAt DateTime
  userId    String
  user      PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@map("refresh_tokens")
}

// ============================================
// SAAS CORE (Modules, Features, Packages)
// ============================================

model Module {
  id        Int     @id @default(autoincrement())
  name      String
  code      String  @unique
  route     String?
  icon      String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  parentId  Int?
  parent    Module? @relation("ModuleHierarchy", fields: [parentId], references: [id])
  children  Module[] @relation("ModuleHierarchy")

  features       ModuleFeature[]
  packageModules PackageModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("modules")
}

model Feature {
  id          Int     @id @default(autoincrement())
  name        String
  code        String  @unique
  description String?

  modules ModuleFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("features")
}

model ModuleFeature {
  moduleId  Int
  featureId Int
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  rolePermissions HospitalRolePermission[]
  userPermissions UserModuleFeaturePermission[]

  @@id([moduleId, featureId])
  @@map("module_features")
}

model Package {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  monthlyPrice Int
  yearlyPrice  Int
  maxDoctors   Int
  maxStorageGb Int
  maxBranches  Int
  isPopular    Boolean @default(false)

  modules          PackageModule[]
  assignedPackages AssignedPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("packages")
}

model PackageModule {
  packageId Int
  moduleId  Int
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  module    Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@id([packageId, moduleId])
  @@map("package_modules")
}

// ============================================
// TENANT / HOSPITAL
// ============================================

model Hospital {
  id          Int            @id @default(autoincrement())
  code        String         @unique
  name        String
  email       String         @unique
  phone       String?
  status      HospitalStatus @default(DRAFT)
  activatedAt DateTime?

  packages           AssignedPackage[]
  users              HospitalUser[]
  hospitalRoles      HospitalRole[]
  departments        Department[]
  shifts             ShiftMaster[]
  roleNamesCreated   RoleName[]
  permissionCopyLogs PermissionCopyLog[]
  doctorProfiles       DoctorProfile[]
  doctorAvailabilities DoctorAvailability[]
  doctorLeaveBlocks    DoctorLeaveBlock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hospitals")
}

model AssignedPackage {
  id         Int                     @id @default(autoincrement())
  hospitalId Int
  packageId  Int
  startDate  DateTime
  endDate    DateTime?
  status     PackageAssignmentStatus @default(ACTIVE)

  hospital  Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@map("assigned_packages")
}

// ============================================
// HIMS - USER & ROLE MANAGEMENT (Hospital Side)
// ============================================

model RoleName {
  id          Int     @id @default(autoincrement())
  name        String
  code        String  @unique
  description String?
  isSystem    Boolean @default(false)

  createdByHospitalId Int?
  createdByHospital   Hospital?      @relation(fields: [createdByHospitalId], references: [id])
  hospitalRoles       HospitalRole[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("role_names")
}

model HospitalRole {
  id         Int      @id @default(autoincrement())
  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  roleNameId Int
  roleName   RoleName @relation(fields: [roleNameId], references: [id], onDelete: Restrict)

  description String?
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)

  permissions HospitalRolePermission[]
  users       UserRoleAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, roleNameId])
  @@index([hospitalId])
  @@map("hospital_roles")
}

model HospitalRolePermission {
  id             Int          @id @default(autoincrement())
  hospitalRoleId Int
  hospitalRole   HospitalRole @relation(fields: [hospitalRoleId], references: [id], onDelete: Cascade)

  moduleId      Int
  featureId     Int
  moduleFeature ModuleFeature @relation(fields: [moduleId, featureId], references: [moduleId, featureId], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([hospitalRoleId, moduleId, featureId])
  @@map("hospital_role_permissions")
}

model Department {
  id         Int      @id @default(autoincrement())
  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name       String
  code       String?
  isActive   Boolean  @default(true)

  users UserDepartmentMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, name])
  @@index([hospitalId])
  @@map("departments")
}

model ShiftMaster {
  id         Int      @id @default(autoincrement())
  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name       String
  startTime  String?
  endTime    String?
  isActive   Boolean  @default(true)

  staffProfiles StaffProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, name])
  @@index([hospitalId])
  @@map("shift_masters")
}

model HospitalUser {
  id         String           @id @default(uuid())
  hospitalId Int
  hospital   Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  userType   HospitalUserType @default(REGULAR_USER)

  firstName       String
  lastName        String?
  email           String 
  mobile          String?
  alternateMobile String?

  username                String
  passwordHash            String
  loginType               LoginType          @default(PASSWORD)
  status                  HospitalUserStatus @default(ACTIVE)
  isTemporaryPassword     Boolean            @default(true)
  forcePasswordChange     Boolean            @default(true)
  twoFactorEnabled        Boolean            @default(false)
  sendCredentialsViaSms   Boolean            @default(false)
  sendCredentialsViaEmail Boolean            @default(false)
  accountValidTill        DateTime?
  refreshTokenHash        String?
  lastLoginAt             DateTime?

  staffProfile StaffProfile?
  roles        UserRoleAssignment[]
  departments  UserDepartmentMapping[]
  permissions  UserModuleFeaturePermission[]
  managedStaff StaffProfile[]              @relation("ReportingManager")

  performedCopyLogs PermissionCopyLog[] @relation("PermissionCopyPerformedBy")
  sourceCopyLogs    PermissionCopyLog[] @relation("PermissionCopySource")
   doctorProfile   DoctorProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, username])
  @@unique([hospitalId,email])
  @@index([hospitalId])
  @@map("hospital_users")
}

model StaffProfile {
  id         Int          @id @default(autoincrement())
  userId     String       @unique
  user       HospitalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId Int
  employeeId String

  title       String?
  dateOfBirth DateTime?
  gender      Gender?
  bloodGroup  String?

  designation   String?
  dateOfJoining DateTime?

  shiftId Int?
  shift   ShiftMaster? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  reportingManagerId String?
  reportingManager   HospitalUser? @relation("ReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)

  aadhaarNumber  String?
  panNumber      String?
  medicalRegNo   String?
  qualification  String?
  specialization String?

  address          String?
  city             String?
  state            String?
  pincode          String?
  emergencyContact String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, employeeId])
  @@index([hospitalId])
  @@map("staff_profiles")
}

model UserRoleAssignment {
  userId         String
  hospitalRoleId Int
  isPrimary      Boolean  @default(false)
  assignedAt     DateTime @default(now())

  user         HospitalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalRole HospitalRole @relation(fields: [hospitalRoleId], references: [id], onDelete: Cascade)

  @@id([userId, hospitalRoleId])
  @@index([hospitalRoleId])
  @@map("user_role_assignments")
}

model UserDepartmentMapping {
  userId       String
  departmentId Int
  user         HospitalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("user_department_mappings")
}

model UserModuleFeaturePermission {
  id        Int          @id @default(autoincrement())
  userId    String
  user      HospitalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId  Int
  featureId Int
  moduleFeature ModuleFeature @relation(fields: [moduleId, featureId], references: [moduleId, featureId], onDelete: Cascade)
  grantedAt DateTime      @default(now())

  @@unique([userId, moduleId, featureId])
  @@index([userId])
  @@map("user_module_feature_permissions")
}

model PermissionCopyLog {
  id         Int      @id @default(autoincrement())
  hospitalId Int
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  performedByUserId String
  performedByUser   HospitalUser @relation("PermissionCopyPerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict)

  sourceUserId String
  sourceUser   HospitalUser @relation("PermissionCopySource", fields: [sourceUserId], references: [id], onDelete: Restrict)

  targetUserIds       String[]
  targetDepartmentIds Int[]

  createdAt DateTime @default(now())

  @@index([hospitalId])
  @@map("permission_copy_logs")
}



// schema.prisma - Fix DoctorProfile, DoctorAvailability, DoctorLeaveBlock
// hospitalId should be Int to match Hospital.id Int

model DoctorProfile {
  id                String   @id @default(uuid())
  hospitalId        Int      // ← Fix: Int not String
  hospitalUserId    String   @unique

  specialization    String
  qualifications    String?
  consultationFee   Decimal  @db.Decimal(10,2)
  slotDurationMins  Int      @default(15)
  bufferTimeMins    Int      @default(0)
  maxPatientsPerDay Int?
  isActive          Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  hospital          Hospital     @relation(fields: [hospitalId], references: [id])
  hospitalUser      HospitalUser @relation(fields: [hospitalUserId], references: [id])

  availabilities    DoctorAvailability[]
  leaveBlocks       DoctorLeaveBlock[]

  @@index([hospitalId])
  @@map("doctor_profiles")  // ← Add map
}

model DoctorAvailability {
  id              String   @id @default(uuid())
  hospitalId      Int      // ← Fix: Int not String
  doctorProfileId String

  dayOfWeek       Int
  startTime       String
  endTime         String
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hospital        Hospital       @relation(fields: [hospitalId], references: [id])
  doctorProfile   DoctorProfile  @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@unique([doctorProfileId, dayOfWeek, startTime])
  @@index([hospitalId, doctorProfileId])
  @@map("doctor_availabilities")  // ← Add map
}

model DoctorLeaveBlock {
  id              String   @id @default(uuid())
  hospitalId      Int      // ← Fix: Int not String
  doctorProfileId String

  blockDate       DateTime @db.Date
  startTime       String?
  endTime         String?
  reason          String?

  createdAt       DateTime @default(now())

  hospital        Hospital       @relation(fields: [hospitalId], references: [id])
  doctorProfile   DoctorProfile  @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)

  @@index([hospitalId, doctorProfileId, blockDate])
  @@map("doctor_leave_blocks")  // ← Add map
}




model AuditLog {
  id         Int      @id @default(autoincrement())
  hospitalId Int?
  userId     String?
  action     String
  entity     String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([hospitalId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}